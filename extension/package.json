{
  "name": "jupyterlite-neme-markdown",
  "version": "1.0.0",
  "description": "NeME-like interactive markdown editor for JupyterLite with LaTeX math menu and table builder",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlite",
    "jupyterlab-extension",
    "neme",
    "markdown",
    "katex",
    "latex"
  ],
  "license": "BSD-3-Clause",
  "author": "Stefan Merkfuss",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "style/**/*.{css,js,eot,gif,html,jpg,json,png,svg,woff2,ttf}"
  ],
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyterlite_neme_markdown/labextension"
  },
  "scripts": {
    "clean": "rimraf lib tsconfig.tsbuildinfo jupyterlite_neme_markdown/labextension",
    "build:lib": "tsc",
    "build:labextension": "python -m jupyter labextension build .",
    "build": "npm run build:lib && python -m jupyter labextension build .",
    "build:prod": "npm run clean && npm run build:lib && python -m jupyter labextension build .",
    "watch": "tsc -w"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/notebook": "^4.0.0",
    "@jupyterlab/cells": "^4.0.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.0.0",
    "rimraf": "^5.0.0",
    "typescript": "~5.0.0"
  }
}
